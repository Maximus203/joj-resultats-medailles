# Copier en apps/api/.env pour changer la configuration (facultatif).

# Port de l'API (3000 par défaut).
# PORT=3000

# Sans DATABASE_URL : PGlite, une base Postgres embarquée, stockée dans PGLITE_DATA_DIR.
# PGLITE_DATA_DIR=.data/pglite

# Import automatique des résultats officiels (éteint par défaut hors production), en heure de SCRAPING_TIMEZONE.
# SCRAPING_ENABLED=true
# SCRAPING_TIMEZONE=Africa/Dakar
# Imports complets (tous les jours, confrontation à la base) aux heures de la liste :
# SCRAPING_FULL_TIMES=07:00,23:00
# Imports légers (finales nouvelles seulement) toutes les N minutes dans la fenêtre :
# SCRAPING_WINDOW_START=08:00
# SCRAPING_WINDOW_END=23:00
# SCRAPING_INTERVAL_MINUTES=15
# Données « en retard » (stale) si aucun import réussi depuis ce nombre de minutes, dans la fenêtre :
# SCRAPING_STALE_AFTER_MINUTES=120
# SCRAPING_FIRST_DAY=2026-11-01
# SCRAPING_LAST_DAY=2026-11-13
# SCRAPING_REQUEST_DELAY_MS=250

# Avec Docker (docker compose up -d), décommenter pour utiliser un vrai Postgres :
# DATABASE_URL=postgres://joj:joj@localhost:5432/joj
